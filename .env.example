# Copy to .env (bun run setup does this for you). Bun loads .env automatically.
# Placeholders only. NEVER commit a real key.

# Model: "mock" runs scripted agents with no API key. Remove it (or leave empty) to use MiniMax.
DEVPILOT_MODEL=mock
# MiniMax credentials (only needed for live runs; set one of these)
MINIMAX_API_KEY=
# MINIMAX_TOKEN_PLAN_KEY=

# Sandbox image pinned by digest; `bun run setup` fills this in.
DEVPILOT_CONTAINER_IMAGE=devpilot-py:1@sha256:<64-hex-digest>

# Optional
# PORT=8787
# DEVPILOT_REASONING_EFFORT=low
# DEVPILOT_ALLOWED_ORIGINS=
